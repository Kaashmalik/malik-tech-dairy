# =============================================================================
# MTK DAIRY - ENVIRONMENT VARIABLE TEMPLATE
# =============================================================================
# Copy this file to .env.local for local development.
# Target Production Domain: https://dairy.mtkcodex.site
# ALL VALUES HERE ARE PLACEHOLDERS. NEVER COMMIT SENSITIVE VALUES OR .env.local
# =============================================================================

# ===================================
# 1. APPLICATION & DOMAIN CONFIGURATION
# ===================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://dairy.mtkcodex.site
NEXT_PUBLIC_APP_NAME="MTK Dairy"
NEXT_PUBLIC_SUPPORT_EMAIL=support@dairy.mtkcodex.site
LOG_LEVEL=info

# ===================================
# 2. CLERK AUTHENTICATION (Multi-tenant SaaS)
# ===================================
# Client-Safe:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Prefer new Clerk redirect props (afterSignInUrl is deprecated)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/api/auth/redirect
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/api/auth/redirect
# Legacy (remove from Vercel when fallback URLs above are set):
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/apply

# Server-Only (CRITICAL SECRETS - Never expose via NEXT_PUBLIC_):
CLERK_SECRET_KEY=sk_test_placeholder_key
CLERK_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# ===================================
# 3. SUPABASE (Primary PostgreSQL Database)
# ===================================
# Client-Safe (Direct connection with Row-Level-Security):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server-Only Database Access & Connection Pooler:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_DATABASE_URL=postgresql://postgres.your-project:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.your-project:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# ===================================
# 4. SECURITY & AUTOMATION CRONS
# ===================================
# Bearer token required for /api/cron/predictions, /api/cron/reminders, /api/migration/schedule:
CRON_SECRET=your-random-32-char-cron-secret-placeholder

# Shared secret for /api/weather/sync endpoint:
WEATHER_SYNC_SECRET=your-random-32-char-weather-secret-placeholder

# 32-byte hex-encoded key (64 characters) for encrypting sensitive tenant records:
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ===================================
# 5. CLOUDINARY FILE STORAGE (Media & Document Uploads)
# ===================================
# Server-Only:
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Client-Safe:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ===================================
# 6. TRANSACTIONAL EMAIL (Resend)
# ===================================
# Server-Only:
RESEND_API_KEY=re_placeholder_api_key
RESEND_FROM_EMAIL="MTK Dairy <noreply@dairy.mtkcodex.site>"

# ===================================
# 7. AI & EXTERNAL APIS
# ===================================
# Server-Only Groq AI Inference:
GROQ_API_KEY=gsk_placeholder_groq_api_key

# Client/Server OpenWeatherMap:
NEXT_PUBLIC_OPENWEATHER_API_KEY=your-openweather-api-key

# ===================================
# 8. CACHE & RATE LIMITING (Upstash Redis)
# ===================================
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token-placeholder

# ===================================
# 9. MONITORING & OBSERVABILITY
# ===================================
# Sentry Error Monitoring:
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-key@o000000.ingest.sentry.io/0000000
SENTRY_DSN=https://your-sentry-key@o000000.ingest.sentry.io/0000000
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=sntrys_placeholder_auth_token

# PostHog Product Analytics:
NEXT_PUBLIC_POSTHOG_KEY=phc_placeholder_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ===================================
# 10. PAYMENT GATEWAYS (Pakistan & Bank Transfer)
# ===================================
# JazzCash (Server-Only):
JAZZCASH_MERCHANT_ID=your-jazzcash-merchant-id
JAZZCASH_PASSWORD=your-jazzcash-password
JAZZCASH_INTEGRETY_SALT=your-jazzcash-integrity-salt
JAZZCASH_RETURN_URL=https://dairy.mtkcodex.site/api/payments/callback/jazzcash

# EasyPaisa (Server-Only):
EASYPAISA_STORE_ID=your-easypaisa-store-id
EASYPAISA_HASH_KEY=your-easypaisa-hash-key
EASYPAISA_RETURN_URL=https://dairy.mtkcodex.site/api/payments/callback/easypaisa

# XPAY Gateway:
XPAY_MERCHANT_ID=your-xpay-merchant-id
XPAY_MERCHANT_KEY=your-xpay-merchant-key
XPAY_RETURN_URL=https://dairy.mtkcodex.site/api/payments/callback/xpay

# Bank Transfer Reference Accounts:
BANK_NAME="Bank Alfalah"
BANK_ACCOUNT_NAME="MTK Dairy Pvt Ltd"
BANK_ACCOUNT_NUMBER="1234567890123"
BANK_IBAN="PK12ALFH1234567890123456"
BANK_BRANCH="Main Branch, Lahore"

# ===================================
# 11. FIREBASE (Legacy Dual-Write & Activity Feeds)
# ===================================
# Client-Safe:
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Server-Only Firebase Admin:
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ===================================
# 12. FEATURE FLAGS & SUBSCRIPTION LIMITS
# ===================================
REQUIRE_ADMIN_APPROVAL=true
FREE_PLAN_FEATURE_LIMITS=true
PROFESSIONAL_PLAN_FEATURE_LIMITS=true
FARM_PLAN_FEATURE_LIMITS=true
ENTERPRISE_PLAN_FEATURE_LIMITS=true

FEATURE_VETERINARY_DISEASE_MANAGEMENT=true
FEATURE_VETERINARY_TREATMENT_TRACKING=true
FEATURE_VETERINARY_VACCINATION_SCHEDULES=true
FEATURE_FEED_INVENTORY_TRACKING=true
FEATURE_FEED_SCHEDULE_AUTOMATION=true
FEATURE_NUTRITION_TEMPLATES=true
FEATURE_STAFF_ATTENDANCE_TRACKING=true
FEATURE_TASK_ASSIGNMENT_SYSTEM=true
FEATURE_PERFORMANCE_REVIEWS=true
FEATURE_MILK_QUALITY_TESTING=true
FEATURE_QUALITY_GRADING_SYSTEM=true
FEATURE_ADULTERATION_DETECTION=true
FEATURE_IOT_DEVICE_MANAGEMENT=false
FEATURE_SENSOR_DATA_INGESTION=false
FEATURE_AUDIT_LOG_ENHANCEMENT=true
FEATURE_MOBILE_RESPONSIVE_UI=true
FEATURE_DARK_MODE_SUPPORT=true
FEATURE_DASHBOARD_REDESIGN=true
FEATURE_AI_PREDICTIVE_ANALYTICS=true
FEATURE_PRODUCTION_FORECASTING=true
FEATURE_HEALTH_MONITORING_AI=true
FEATURE_REAL_TIME_MONITORING=true
FEATURE_COMPLIANCE_REPORTING=true
FEATURE_DATA_EXPORT_FEATURES=true
