# Vercel ignore file
# Files and directories to exclude from deployment

# Dependencies
node_modules/

# Build outputs (Vercel builds these)
.next/
out/
dist/
build/

# Environment files (use Vercel environment variables instead)
.env
.env.local
.env.development
.env.production
.env.test

# Testing
coverage/
.nyc_output/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/
cypress/
cypress.config.ts

# Development tools
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation (optional - can include if needed)
# docs/
# *.md

# Scripts (keep only if needed for build)
scripts/load-tests/
scripts/test-*.js
scripts/check-*.js

# Backup files
*.backup
*.bak
.next_corrupted_backup/

# Temporary files
tmp/
temp/
*.tmp

